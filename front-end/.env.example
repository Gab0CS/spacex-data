# Base URL of the FastAPI backend the frontend talks to.

# Local development (matches docker-compose / `uvicorn` running on the host):
VITE_API_BASE_URL=http://localhost:8000

# Production: set this in the Netlify UI (Site settings -> Environment variables)
# to your deployed FastAPI backend's public URL, e.g.:
# VITE_API_BASE_URL=https://spacex-api.yourdomain.com
