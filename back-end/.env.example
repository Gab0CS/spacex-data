# Serve canned SpaceX data instead of calling the live API (useful offline/for demos).
#current API is not working now so 
USE_MOCK_DATA=true

# Upstream SpaceX API.
SPACEX_API_BASE_URL=https://api.spacexdata.com
SPACEX_API_TIMEOUT_SECONDS=10

# In-memory cache of SpaceX API responses. Ephemeral: reset whenever the process restarts.
CACHE_TTL_SECONDS=900
CACHE_REFRESH_INTERVAL_SECONDS=300

# Comma-separated list of origins allowed to call this API (no spaces).
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# Production ASGI server (see Dockerfile).
PORT=8000
WEB_CONCURRENCY=2
